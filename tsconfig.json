{
  // A solution file: `tsc -b` builds the three projects below and compiles nothing itself.
  // Vercel compiles api/*.ts against this file directly (it skips references and adds
  // rewriteRelativeImportExtensions), so these options exist for that compile alone.
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "files": [],
  "references": [
    { "path": "./tsconfig.app.json" },
    { "path": "./tsconfig.node.json" },
    { "path": "./tsconfig.shared.json" }
  ]
}
